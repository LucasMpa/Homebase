# Copie para .env.local e preencha. Lido pelo Next.js e pelo docker-compose.yml
# (container do Auth, para as credenciais do Google).

# --- App (Next.js) ---
# Valores locais fixos do docker-compose.yml (segredos de demonstração da Supabase).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Usada apenas pelos scripts (seed, sync). Nunca exponha no cliente.
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Único e-mail com acesso ao app.
ALLOWED_EMAIL=voce@gmail.com

# --- E-mail (avisos de vencimento das contas) ---
# Local: o docker-compose já aponta o Next para o Mailpit (http://localhost:54324).
# Rodando o `pnpm dev` fora do Docker, use:
# MAILPIT_URL=http://localhost:54324
# Produção (Vercel): chave do Resend. Com ela definida, o Mailpit é ignorado.
# RESEND_API_KEY=re_xxx
# Remetente. Sem domínio verificado no Resend, deixe o padrão (só entrega para o e-mail da conta Resend).
# EMAIL_FROM=Homebase <onboarding@resend.dev>
# Segredo do job diário de avisos (Vercel Cron → /api/cron/bill-reminders), 32+ caracteres:
#   openssl rand -base64 32
# Cadastre o mesmo valor na Vercel e grave o hash no banco com `pnpm sync:cron-secret`.
# No Docker local já existe um valor de demonstração (docker-compose.yml).
# CRON_SECRET=
# Base dos links do e-mail. Na Vercel, sem isso, usa o domínio de produção do projeto.
# APP_URL=https://seu-app.vercel.app

# --- Google OAuth (Google Cloud Console → Credenciais) ---
# Depois de alterar, recrie o Auth: docker compose up -d --force-recreate auth
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=xxx
