{
  "name": "homebase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase": "supabase",
    "seed:dev": "tsx --env-file=.env.local scripts/seed-dev.ts",
    "db:types": "docker compose exec -T meta node -e \"fetch('http://localhost:8080/generators/typescript?included_schemas=public,graphql_public&postgrest_version=16.4').then((r) => (r.ok ? r.text() : Promise.reject(r.status))).then((t) => process.stdout.write(t))\" > src/lib/supabase/database.types.ts.tmp && mv src/lib/supabase/database.types.ts.tmp src/lib/supabase/database.types.ts",
    "sync:allowed-email": "tsx --env-file=.env.local scripts/sync-allowed-email.mts",
    "predev": "pnpm sync:allowed-email"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.24.0"
}
